#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage:
  ./segen c <raw_file> <archive_file> [recipient_public.pem] [threads] [K] [S] [GPU] [vocab_size]
  ./segen d <archive_file> <recovered_file> [recipient_private.pem] [threads] [K] [S] [GPU] [vocab_size]

For one-to-one testing, omitted key paths default to recipient_public.pem and
recipient_private.pem beside this script. A numeric third optional argument is
treated as the thread count.
EOF
}

[[ $# -ge 3 ]] || { usage >&2; exit 2; }
mode=$1
segen_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
[[ -f "$2" ]] || { echo "Error: input file does not exist: $2" >&2; exit 1; }
input_file=$(realpath "$2")
output_file=$(realpath -m "$3")

if [[ ${4:-} =~ ^[0-9]+$ || -z ${4:-} ]]; then
    if [[ "$mode" == "c" ]]; then
        key_file="$segen_dir/recipient_public.pem"
    else
        key_file="$segen_dir/recipient_private.pem"
    fi
    parameter_index=4
else
    key_file=$4
    parameter_index=5
fi
[[ -f "$key_file" ]] || { echo "Error: key file does not exist: $key_file" >&2; exit 1; }
key_file=$(realpath "$key_file")
threads=${!parameter_index:-32}
K_index=$((parameter_index + 1))
S_index=$((parameter_index + 2))
GPU_index=$((parameter_index + 3))
VOCAB_index=$((parameter_index + 4))
K=${!K_index:-3}
S=${!S_index:-3}
GPU=${!GPU_index:-0}
[[ "$threads" =~ ^[1-9][0-9]*$ ]] || { echo "Error: threads must be a positive integer." >&2; exit 2; }
[[ "$K" =~ ^[1-4]$ && "$S" =~ ^[1-4]$ && "$GPU" =~ ^[0-9]+$ ]] || {
    echo "Error: K and S must be in 1..4, and GPU must be a non-negative integer." >&2
    exit 2
}
(( S <= K )) || { echo "Error: S must not be greater than K." >&2; exit 2; }
MIN_VOCAB_SIZE=$((4 ** K))
VOCAB_SIZE=${!VOCAB_index:-$MIN_VOCAB_SIZE}
[[ "$VOCAB_SIZE" =~ ^[1-9][0-9]*$ ]] || {
    echo "Error: vocab_size must be a positive integer." >&2
    exit 2
}
(( VOCAB_SIZE >= MIN_VOCAB_SIZE )) || {
    echo "Error: vocab_size must be at least 4^K ($MIN_VOCAB_SIZE)." >&2
    exit 2
}

prsec="$segen_dir/PRSEC/prsec"
skmer="$segen_dir/PRSEC/skmer"
[[ -x "$prsec" && -x "$skmer" ]] || { echo "Error: build PRSEC/prsec and provide PRSEC/skmer." >&2; exit 1; }
[[ -f "$segen_dir/dataBaseSrf.txt" ]] || { echo "Error: dataBaseSrf.txt does not exist." >&2; exit 1; }
cd "$segen_dir"

work_dir=$(mktemp -d "$segen_dir/.segen.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT
payload_dir="$work_dir/payload"

case "$mode" in
    c)
        mkdir "$payload_dir"
        "$prsec" -c "$threads" "$input_file" "$key_file" "$payload_dir"
        (
            cd "$payload_dir"
            "$skmer" encry.data "$K" "$S" "$GPU"
            python "$segen_dir/compress.py" "encry.data_${K}_${S}.npy" sequence.compressed \
                --prefix "encry.data_${K}_${S}" --gpu "$GPU" --vocab_size "$VOCAB_SIZE"
            mv "params_encry.data_${K}_${S}" compression.params
            rm -f encry.data "encry.data_${K}_${S}.npy"
        )
        # Use one 512-byte tar record so metadata savings are reflected in the archive size.
        tar --blocking-factor=1 -C "$work_dir" -cf "$output_file" payload
        echo "Created authenticated SeGen archive: $output_file"
        ;;
    d)
        expected_members=$'payload/\npayload/auth.tag\npayload/compression.params\npayload/metadata.bin\npayload/sequence.compressed\npayload/wrapped_key.bin'
        members=$(tar -tf "$input_file" | LC_ALL=C sort)
        [[ "$members" == "$expected_members" ]] || {
            echo "Error: archive has an unexpected layout." >&2
            exit 1
        }
        tar -C "$work_dir" -xf "$input_file"
        (
            cd "$payload_dir"
            mv compression.params "params_encry.data_${K}_${S}"
            python "$segen_dir/decompress.py" sequence.compressed encry.data \
                --prefix "encry.data_${K}_${S}" --gpu "$GPU" \
                --K "$K" --S "$S" --vocab_size "$VOCAB_SIZE"
        )
        "$prsec" -d "$threads" "$payload_dir/encry.data" "$payload_dir/metadata.bin" \
            "$payload_dir/wrapped_key.bin" "$payload_dir/auth.tag" "$key_file" "$output_file"
        echo "Recovered authenticated sequence: $output_file"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
